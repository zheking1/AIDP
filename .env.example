# AIDP Environment Variables
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://novel_os:CHANGE_ME@127.0.0.1:5432/novel_os

# Redis (for skill-router)
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# JWT / Session Secrets
JWT_SECRET=CHANGE_ME
CONTROLLER_SECRET_KEY=CHANGE_ME
SKILLROUTER_SESSION_KEY=CHANGE_ME
CONTROLLER_SESSION_KEY=CHANGE_ME

# Tool Secrets
MEMORY_TOOL_SECRET_KEY=CHANGE_ME
QUALITY_TOOL_SECRET_KEY=CHANGE_ME
SANDBOX_TOOL_SECRET_KEY=CHANGE_ME
KNOWLEDGE_TOOL_SECRET_KEY=CHANGE_ME
ASSET_TOOL_SECRET_KEY=CHANGE_ME

# LLM (for skill-router)
LLM_ENDPOINT=http://localhost:8000/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash-free
EMBEDDING_ENDPOINT=http://localhost:8000/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# Skill Manager API Key
SKILL_MANAGER_API_KEY=sk-1234567890